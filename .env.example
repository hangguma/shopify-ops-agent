# Copy this file to .env and fill in your real keys:
#   cp .env.example .env

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shopify Dev Dashboard 앱 - Admin API (client credentials grant)
# 1) https://dev.shopify.com/dashboard -> Stores -> Create store (dev store, 무료)
# 2) Create app -> Start from Dev Dashboard
# 3) 앱 -> Versions 탭 -> access scopes 설정 (read_products, read_orders,
#    read_inventory) -> Release
# 4) 앱 -> Home -> Install app -> dev store에 설치
# 5) 앱 -> Settings -> Client ID / Client secret 복사
# 토큰은 코드가 런타임에 발급·캐싱한다 (24h 만료) - .env에 토큰을 두지 않음
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
SHOPIFY_API_VERSION=2026-04

# (Optional) LLM model to use - the default is fine
# LLM_MODEL=anthropic/claude-sonnet-5
